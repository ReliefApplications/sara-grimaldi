{
  "name": "sara-grimaldi",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "content": "node tools/build-content.mjs",
    "start": "node tools/start.mjs",
    "build": "node tools/build-content.mjs --production && ng build",
    "postbuild": "node tools/spa-fallback.mjs && node tools/check-dist.mjs",
    "test": "npm run content && ng test",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"content/**/*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"content/**/*.json\""
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.6",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.7",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
