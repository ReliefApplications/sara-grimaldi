  "logline": {
    "fr": "Un documentaire sur des adultes atteints d’un déficit immunitaire primitif et sur leur résilience.",
    "en": "A documentary about adults living with primary immunodeficiency, and their resilience."
  },
  "synopsis": {
    "fr": [
      "Matteo Pellegrinuzzi, photographe installé à Paris et né avec un déficit immunitaire primitif, décide en juillet 2019 de relier Paris à Londres à vélo, soit 270 km, en moins de 24 heures pour faire connaître la maladie.",
      "Le film suit ses huit mois de préparation et croise son parcours avec la vie de trois autres patients."
    ],
    "en": [
      "Matteo Pellegrinuzzi, a Paris-based photographer born with primary immunodeficiency, decides in July 2019 to cycle the 270 km from Paris to London in under 24 hours to raise awareness of the condition.",
      "The film follows his eight months of preparation and weaves in the lives of three other patients."
    ]
  },
  "statementQuote": {
    "fr": "« C’est une ode à la vie, qui mérite d’être vécue malgré les difficultés que nous pouvons rencontrer. »",
    "en": "“It is an ode to life, which deserves to be lived in spite of the difficulties we may face.”"
  },
